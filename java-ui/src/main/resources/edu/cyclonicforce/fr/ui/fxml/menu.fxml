<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="30" stylesheets="@/edu/cyclonicforce/fr/ui/styles/menu.css" xmlns:fx="http://javafx.com/fxml">
    <padding><Insets top="20" right="40" bottom="20" left="40"/></padding>

    <HBox spacing="20" alignment="CENTER">
        <Button text="Tuto" styleClass="menu-button"/>
        <Button text="Mes rapports" styleClass="menu-button"/>
        <Button text="Paramètres" styleClass="menu-button"/>
    </HBox>

    <VBox spacing="15">
        <Label text="Faire un diagnostique" styleClass="header-text"/>
        <HBox spacing="20">
            <VBox styleClass="card" spacing="10">
                <Label text="Les 10 règles ANSSI" styleClass="card-title"/>
                <Label text="Diagnostic basé sur les règles de l'ANSSI..." styleClass="card-description"/>
                <Button text="Lancer le diagnostic →" styleClass="action-button" maxWidth="Infinity"/>
            </VBox>
            <VBox styleClass="card" spacing="10">
                <Label text="Performances" styleClass="card-title"/>
                <Label text="Évaluation de l'utilisation des ressources..." styleClass="card-description"/>
                <Button text="Lancer le diagnostic →" styleClass="action-button" maxWidth="Infinity"/>
            </VBox>
        </HBox>
    </VBox>

    <VBox spacing="15">
        <Label text="Choisir ses modules" styleClass="header-text"/>
        <HBox spacing="20">
            <VBox styleClass="card" spacing="10">
                <Label text="cpuUsage" styleClass="card-title"/>
                <Label text="Check CPU usage on the system." styleClass="card-description"/>
                <Button text="Lancer le module →" styleClass="action-button" maxWidth="Infinity"/>
            </VBox>
            <VBox styleClass="card" spacing="10">
                <Label text="diskUsage" styleClass="card-title"/>
                <Label text="Check disk usage on the system." styleClass="card-description"/>
                <Button text="Lancer le module →" styleClass="action-button" maxWidth="Infinity"/>
            </VBox>
        </HBox>
    </VBox>
</VBox>